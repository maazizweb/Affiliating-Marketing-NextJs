# WooCommerce REST API (server-only — never prefix these with NEXT_PUBLIC_)
# Store URL must be HTTPS: the API keys are sent with HTTP Basic auth.
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Optional: secret for the WooCommerce webhook that triggers /api/revalidate
WOOCOMMERCE_WEBHOOK_SECRET=

# Public, non-secret site info (canonical URLs, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=My Store
